---
import { Font } from "astro:assets";
import Analytics from "@vercel/analytics/astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollTop from "../components/ScrollTop.astro";
import { site } from "../constants";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Structured data objects, each emitted as its own JSON-LD script. */
  jsonLd?: Record<string, unknown>[];
  ogType?: "website" | "article" | "profile";
}

const { title, description, jsonLd = [], ogType = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", site.url).href;
const ogImage = new URL("/og-image.png", site.url).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f4eee4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1813" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Omar — oyousaf.dev" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Omar, frontend web developer — oyousaf.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-funnel-display" preload />

    <script is:inline>
      // Apply the stored choice, or the device theme by default, before first paint.
      (() => {
        let pref;
        try {
          pref = localStorage.getItem("theme");
        } catch {
          /* storage blocked */
        }
        if (pref !== "light" && pref !== "dark") pref = "system";
        const root = document.documentElement;
        root.dataset.pref = pref;
        root.dataset.theme =
          pref === "system"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : pref;
      })();
    </script>

    {
      jsonLd.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only z-90 rounded-full bg-ink px-5 py-3 text-paper focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <ScrollTop />
    <Analytics />
  </body>
</html>
