---
// An original raymarched "watermelon" metaball cluster in raw WebGL: no 3D
// library, a few KB of script. Static frame under reduced motion, paused when
// off screen, CSS gradient fallback when WebGL is unavailable.
---

<div class="hero-field relative aspect-square w-full" aria-hidden="true">
  <div class="fallback absolute inset-[12%] rounded-full"></div>
  <canvas data-hero-field class="absolute inset-0 size-full opacity-0 transition-opacity duration-700"></canvas>
</div>

<style>
  .fallback {
    background:
      radial-gradient(circle at 35% 30%, var(--melon-cream) 0 6%, transparent 7%),
      radial-gradient(circle at 50% 50%, var(--melon-flesh) 0 48%, var(--melon-cream) 52% 58%, var(--melon-rind) 62% 70%, transparent 71%);
    filter: blur(0.5px);
  }
  .hero-field:has(canvas.is-live) .fallback {
    display: none;
  }
  canvas.is-live {
    opacity: 1;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-field]");
  const gl = canvas?.getContext("webgl", {
    alpha: true,
    antialias: false,
    premultipliedAlpha: true,
    powerPreference: "low-power",
  });

  const VERT = `attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}`;

  const FRAG = `precision highp float;
uniform vec2 uRes;uniform float uTime;uniform vec2 uPtr;
uniform vec3 uFlesh;uniform vec3 uCream;uniform vec3 uRind;
vec3 c0;vec3 c1;vec3 c2;vec3 c3;vec3 c4;
float smin(float a,float b,float k){float h=clamp(.5+.5*(b-a)/k,0.,1.);return mix(b,a,h)-k*h*(1.-h);}
float map(vec3 p){
  float d=length(p-c0)-.68;
  d=smin(d,length(p-c1)-.44,.42);
  d=smin(d,length(p-c2)-.36,.42);
  d=smin(d,length(p-c3)-.3,.38);
  d=smin(d,length(p-c4)-.24,.5);
  return d;
}
vec3 hash3(vec3 p){return fract(sin(vec3(dot(p,vec3(127.1,311.7,74.7)),dot(p,vec3(269.5,183.3,246.1)),dot(p,vec3(113.5,271.9,124.6))))*43758.5453);}
// Sparse seeds pinned to whichever blob the point belongs to, so they ride
// along with it. Returns 0..1 coverage.
float seeds(vec3 p){
  vec3 c=c0;float k=0.;float m=length(p-c0)-.68;float e;
  e=length(p-c1)-.44;if(e<m){m=e;c=c1;k=1.;}
  e=length(p-c2)-.36;if(e<m){m=e;c=c2;k=2.;}
  e=length(p-c3)-.3;if(e<m){m=e;c=c3;k=3.;}
  e=length(p-c4)-.24;if(e<m){m=e;c=c4;k=4.;}
  vec3 q=normalize(p-c);
  float a=uTime*.12+k*1.7;float ca=cos(a);float sa=sin(a);
  q=vec3(ca*q.x+sa*q.z,q.y,-sa*q.x+ca*q.z);
  vec3 g=q*4.2+k*7.3;vec3 cell=floor(g);vec3 h=hash3(cell);
  if(h.x>.6)return 0.;
  vec3 o=fract(g)-(.28+.44*h.yzx);
  float d=length(o*vec3(1.,1.7,1.));
  return 1.-smoothstep(.085,.12,d);
}
vec3 nrm(vec3 p){vec2 e=vec2(.003,0.);return normalize(vec3(map(p+e.xyy)-map(p-e.xyy),map(p+e.yxy)-map(p-e.yxy),map(p+e.yyx)-map(p-e.yyx)));}
void main(){
  float tm=uTime*.32;
  c0=vec3(sin(tm)*.42,cos(tm*1.3)*.3,sin(tm*.7)*.25);
  c1=vec3(cos(tm*.8)*.78,sin(tm*1.1)*.52,cos(tm*.5)*.35);
  c2=vec3(sin(tm*1.4+2.)*.55,sin(tm*.6+1.)*.78,.15);
  c3=vec3(cos(tm*.9+4.)*.8,cos(tm*1.2+3.)*.5,-.2);
  c4=vec3(uPtr*.95,.45);
  float s=min(uRes.x,uRes.y);
  vec2 uv=(gl_FragCoord.xy-.5*uRes)/s;
  vec3 ro=vec3(0.,0.,4.3);vec3 rd=normalize(vec3(uv,-1.55));
  float px=1.6/(s*1.55);
  float t=.5;float best=1e9;float tb=t;
  for(int i=0;i<96;i++){
    float d=map(ro+rd*t);
    float r=d/t;if(r<best){best=r;tb=t;}
    if(d<.0004*t){tb=t;best=-1.;break;}
    if(t>8.)break;
    t+=d*.85;
  }
  float a=1.-smoothstep(0.,px,best);
  if(a<=0.){gl_FragColor=vec4(0.);return;}
  vec3 p=ro+rd*tb;vec3 n=nrm(p);
  vec3 l=normalize(vec3(.55,.75,.9));
  float f=1.-max(dot(n,-rd),0.);
  vec3 col=mix(uFlesh,uCream,smoothstep(.42,.52,f));
  col=mix(col,uRind,smoothstep(.56,.68,f));
  // Seeds only on the flesh, fading out well before the cream band.
  col=mix(col,vec3(.17,.09,.08),.55*seeds(p)*(1.-smoothstep(.26,.4,f)));
  float dif=max(dot(n,l),0.);
  col*=.62+.5*dif;
  col+=.55*pow(max(dot(reflect(-l,n),-rd),0.),36.);
  col+=.08*uCream*(1.-dif);
  gl_FragColor=vec4(col*a,a);
}`;

  const hex = (v: string): [number, number, number] => {
    const h = v.trim().replace("#", "");
    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16) / 255) as [number, number, number];
  };

  const compile = (ctx: WebGLRenderingContext, type: number, src: string) => {
    const sh = ctx.createShader(type)!;
    ctx.shaderSource(sh, src);
    ctx.compileShader(sh);
    return ctx.getShaderParameter(sh, ctx.COMPILE_STATUS) ? sh : null;
  };

  if (canvas && gl) {
    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
    const prog = gl.createProgram();
    if (vs && fs && prog) {
      gl.attachShader(prog, vs);
      gl.attachShader(prog, fs);
      gl.linkProgram(prog);
    }

    if (vs && fs && prog && gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, "p");
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

      const u = (n: string) => gl.getUniformLocation(prog, n);
      const uRes = u("uRes"), uTime = u("uTime"), uPtr = u("uPtr");
      const uFlesh = u("uFlesh"), uCream = u("uCream"), uRind = u("uRind");

      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      let scale = Math.min(devicePixelRatio || 1, 1.5);
      let visible = true;
      let raf = 0;
      let last = 0;
      let elapsed = 8;
      let slow = 0;
      const ptr = { x: 0, y: 0, tx: 0, ty: 0 };

      const palette = () => {
        const cs = getComputedStyle(document.documentElement);
        gl.uniform3fv(uFlesh, hex(cs.getPropertyValue("--melon-flesh")));
        gl.uniform3fv(uCream, hex(cs.getPropertyValue("--melon-cream")));
        gl.uniform3fv(uRind, hex(cs.getPropertyValue("--melon-rind")));
      };

      const resize = () => {
        const { width, height } = canvas.getBoundingClientRect();
        canvas.width = Math.max(1, Math.round(width * scale));
        canvas.height = Math.max(1, Math.round(height * scale));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
      };

      const draw = () => {
        gl.uniform1f(uTime, elapsed);
        gl.uniform2f(uPtr, ptr.x, ptr.y);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };

      const frame = (now: number) => {
        const dt = last ? Math.min((now - last) / 1000, 0.1) : 0.016;
        last = now;
        elapsed += dt;
        ptr.x += (ptr.tx - ptr.x) * Math.min(dt * 4, 1);
        ptr.y += (ptr.ty - ptr.y) * Math.min(dt * 4, 1);
        draw();
        // Adapt resolution on slow devices.
        slow = dt > 0.028 ? slow + 1 : Math.max(0, slow - 1);
        if (slow > 20 && scale > 0.6) {
          scale *= 0.8;
          slow = 0;
          resize();
        }
        raf = requestAnimationFrame(frame);
      };

      const start = () => {
        if (raf || !visible || document.hidden || reduce.matches) return;
        last = 0;
        raf = requestAnimationFrame(frame);
      };
      const stop = () => {
        cancelAnimationFrame(raf);
        raf = 0;
      };

      palette();
      resize();
      draw();
      canvas.classList.add("is-live");
      start();

      new ResizeObserver(() => {
        resize();
        draw();
      }).observe(canvas);
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) start();
        else stop();
      }).observe(canvas);
      document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
      reduce.addEventListener("change", () => (reduce.matches ? stop() : start()));
      new MutationObserver(() => {
        palette();
        draw();
      }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

      window.addEventListener(
        "pointermove",
        (e) => {
          const r = canvas.getBoundingClientRect();
          ptr.tx = Math.max(-1.2, Math.min(1.2, ((e.clientX - r.left) / r.width) * 2 - 1));
          ptr.ty = Math.max(-1.2, Math.min(1.2, -(((e.clientY - r.top) / r.height) * 2 - 1)));
        },
        { passive: true },
      );
    }
  }
</script>
