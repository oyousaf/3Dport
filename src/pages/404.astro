---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — Omar" description="This page doesn't exist. Head back to Omar's portfolio.">
  <section class="wrap grid min-h-[70dvh] place-content-center py-20 text-center">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="display-xl mt-4 font-bold">All rind<span class="text-flesh">,</span> no fruit.</h1>
    <p class="mx-auto mt-6 max-w-md text-lg text-muted">
      This page doesn&rsquo;t exist, or it&rsquo;s moved. The good stuff is back on the home page.
    </p>
    <div class="mt-9 flex justify-center gap-3">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/#work" class="btn btn-ghost">See the work</a>
    </div>
  </section>
</Base>
