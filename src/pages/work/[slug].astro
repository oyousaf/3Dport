---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { projects, site, type Project } from "../../constants";

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      index: i,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  index: number;
  prev: Project;
  next: Project;
}

const { project, index, prev, next } = Astro.props;
const url = `${site.url}/work/${project.slug}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: project.title,
    description: project.desc,
    url,
    image: new URL(project.texture, site.url).href,
    sameAs: project.href,
    keywords: project.tags.join(", "),
    creator: { "@type": "Person", "@id": `${site.url}/#person`, name: site.name, url: site.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Work", item: `${site.url}/#work` },
      { "@type": "ListItem", position: 3, name: project.title, item: url },
    ],
  },
];
---

<Base
  title={`${project.title} — Work by Omar, Frontend Web Developer`}
  description={project.desc}
  jsonLd={jsonLd}
  ogType="article"
>
  <article class="wrap pt-10 pb-20 sm:pt-14">
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="link">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/#work" class="link">Work</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{project.title}</li>
      </ol>
    </nav>

    <header class="mt-10 grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-end">
      <div>
        <p class="font-mono text-xs text-muted">Project {String(index + 1).padStart(2, "0")} / {projects.length}</p>
        <h1 class="display-xl mt-4 font-bold">{project.title}</h1>
      </div>
      <div class="space-y-5">
        <p class="text-lg leading-relaxed text-muted">{project.desc}</p>
        <a href={project.href} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Visit the live site <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </header>

    <div
      class="mt-12 overflow-hidden rounded-3xl border border-ink/10 bg-paper-2 sm:rounded-4xl"
      style={`box-shadow: 0 40px 100px -50px ${project.accent}`}
    >
      <img
        src={project.texture}
        alt={`${project.title} website landing page`}
        width="1600"
        height="1000"
        fetchpriority="high"
        decoding="async"
        class="aspect-16/10 w-full object-cover"
        style={`view-transition-name: shot-${project.slug}`}
      />
    </div>

    <dl class="mt-12 grid gap-8 border-t border-ink/10 pt-8 md:grid-cols-3">
      <div>
        <dt class="font-mono text-xs tracking-[0.18em] text-muted uppercase">Built with</dt>
        <dd class="mt-3">
          <ul class="flex flex-wrap gap-2">
            {project.tags.map((tag) => <li class="chip text-sm text-ink">{tag}</li>)}
          </ul>
        </dd>
      </div>
      <div class="md:col-span-2">
        <dt class="font-mono text-xs tracking-[0.18em] text-muted uppercase">Stack notes</dt>
        <dd class="mt-3 text-lg text-muted">{project.subdesc}</dd>
      </div>
    </dl>

    <nav aria-label="More projects" class="mt-20 grid gap-4 sm:grid-cols-2">
      <a
        href={`/work/${prev.slug}`}
        class="group rounded-3xl border border-ink/10 p-6 transition-colors hover:border-ink"
      >
        <span class="font-mono text-xs text-muted">← Previous</span>
        <span class="mt-2 block font-display text-2xl font-semibold tracking-tight group-hover:text-flesh">{prev.title}</span>
      </a>
      <a
        href={`/work/${next.slug}`}
        class="group rounded-3xl border border-ink/10 p-6 text-right transition-colors hover:border-ink"
      >
        <span class="font-mono text-xs text-muted">Next →</span>
        <span class="mt-2 block font-display text-2xl font-semibold tracking-tight group-hover:text-flesh">{next.title}</span>
      </a>
    </nav>
  </article>
</Base>
